{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fredi-smart-detect",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "GATEWAY_TOKEN_SHA256": "0d95010fbaf5baac199a555c2639e4eb908875d8c8383abb18a8193a84456188"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
