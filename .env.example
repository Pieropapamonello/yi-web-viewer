# Copy to .env. This file is ignored by Git.
# IPC365 / ONVIF camera discovered in the LAN. Add credentials here only if
# RTSP authentication is enabled later; never commit the resulting .env file.
IPC365_RTSP_URL=rtsp://192.168.1.50:554/cam/realmonitor?channel=1&subtype=0
FREDI_G1_RTSP_URL=rtsp://192.168.1.78/ch0_0.h264

# Required only when starting the optional EasyProxy profile.
EASYPROXY_API_PASSWORD=replace-with-a-long-random-password
