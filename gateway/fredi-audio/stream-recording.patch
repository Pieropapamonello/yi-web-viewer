 #include <sys/ioctl.h>
 #include <rts_io_adc.h>
 #include <sys/resource.h>
+#include <time.h>
+#include <dirent.h>
+#include <sys/statvfs.h>
 
 #define FIFO_NAME_HIGH "/tmp/h264_high_fifo"
+#define RECORD_FLAG "/var/tmp/sd/recording.enabled"
+#define RECORD_DIR "/var/tmp/sd/recordings"
+#define RECORD_LIMIT_FILE "/var/tmp/sd/recording.limit"
+#define RECORD_SEGMENT_SECONDS 60
+#define RECORD_RESERVE_BYTES (512ULL * 1024ULL * 1024ULL)
 //#define DOMAIN_GPIO_MCU    1
 //#define GPIO_ANODE 20
 //#define GPIO_CATHODE 21
 
 int isp = -1;
 static int g_exit;
+static FILE *record_fd;
+static time_t record_started;
+static char record_partial[256];
+static char record_final[256];
+
+static void recorder_close(void) {
+    if (!record_fd) return;
+    fflush(record_fd); fsync(fileno(record_fd)); fclose(record_fd); record_fd = NULL;
+    rename(record_partial, record_final);
+}
+
+static unsigned long long recorder_limit(void) {
+    FILE *file = fopen(RECORD_LIMIT_FILE, "r"); unsigned long long value = 0;
+    if (file) { fscanf(file, "%llu", &value); fclose(file); }
+    return value;
+}
+
+static unsigned long long recorder_free(void) {
+    struct statvfs filesystem;
+    if (statvfs(RECORD_DIR, &filesystem)) return RECORD_RESERVE_BYTES;
+    return (unsigned long long)filesystem.f_bavail * (unsigned long long)filesystem.f_frsize;
+}
+
+static int recorder_oldest(char *oldest, size_t capacity, unsigned long long *total) {
+    DIR *dir = opendir(RECORD_DIR); struct dirent *entry; struct stat info; time_t oldest_time = 0;
+    if (!dir) return 0; *total = 0; oldest[0] = '\0';
+    while ((entry = readdir(dir))) {
+        char full[256]; size_t length = strlen(entry->d_name);
+        if (!((length >= 5 && !strcmp(entry->d_name + length - 5, ".h264")) || (length >= 4 && !strcmp(entry->d_name + length - 4, ".jpg")))) continue;
+        snprintf(full, sizeof(full), "%s/%s", RECORD_DIR, entry->d_name);
+        if (stat(full, &info)) continue; *total += (unsigned long long)info.st_size;
+        if (!oldest_time || info.st_mtime < oldest_time) { oldest_time = info.st_mtime; strncpy(oldest, full, capacity - 1); oldest[capacity - 1] = '\0'; }
+    }
+    closedir(dir); return oldest[0] != '\0';
+}
+
+static void recorder_trim(void) {
+    unsigned long long limit = recorder_limit(), total = 0; char oldest[256];
+    while (recorder_oldest(oldest, sizeof(oldest), &total)) {
+        if ((limit && total <= limit) || (!limit && recorder_free() >= RECORD_RESERVE_BYTES)) break;
+        if (unlink(oldest)) break;
+    }
+}
+
+static void recorder_open(time_t now) {
+    struct tm *local;
+    mkdir(RECORD_DIR, 0755); local = localtime(&now); if (!local) return;
+    strftime(record_final, sizeof(record_final), RECORD_DIR "/fredi_%Y-%m-%d_%H-%M-%S.h264", local);
+    snprintf(record_partial, sizeof(record_partial), "%s.partial", record_final);
+    record_fd = fopen(record_partial, "wb"); record_started = now;
+    recorder_trim();
+}
+
+static void recorder_write(const void *data, size_t size, int key_frame) {
+    time_t now = time(NULL); int enabled = access(RECORD_FLAG, F_OK) == 0;
+    if (!enabled) { recorder_close(); return; }
+    if (record_fd && key_frame && now - record_started >= RECORD_SEGMENT_SECONDS) recorder_close();
+    if (!record_fd) { if (!key_frame) return; recorder_open(now); }
+    if (record_fd && fwrite(data, 1, size, record_fd) != size) recorder_close();
+}
+
+static int recorder_is_key(const unsigned char *data, size_t size) {
+    size_t i;
+    for (i = 0; i + 5 < size; i++) {
+        size_t nal = 0;
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) nal = i + 3;
+        else if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 0 && data[i + 3] == 1) nal = i + 4;
+        if (nal && ((data[nal] & 0x1f) == 5 || (data[nal] & 0x1f) == 7)) return 1;
+    }
+    return 0;
+}
 int night = 3;
