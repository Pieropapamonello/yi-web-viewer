ONVIF_HOST=192.168.1.50
TZ=Europe/Rome
ONVIF_PORT=8080
ONVIF_USERNAME=admin
ONVIF_PASSWORD=replace-locally
API_TOKEN=replace-with-at-least-24-random-characters
ALLOWED_ORIGIN=https://yi-web-viewer.onrender.com
PTZ_SPEED=0.45
PTZ_DURATION_MS=350
ONVIF_TIME_OFFSET_MS=0
IPC365_PTZ_PORT=23456
IPC365_PTZ_STEP=12
# Four raw bytes (8 hexadecimal characters) captured from the IPC365 session.
# PCAPdroid: command 0x4f77, offsets 20 and 24. These values are not passwords.
IPC365_SOURCE_ID=af93c63b
IPC365_DEVICE_ID=09f74b01
DASHBOARD_PASSWORD_ITERATIONS=310000
AUTH_SECRET=generated-locally
VAULT_KEY=generated-locally
ACCOUNTS_FILE=/data/accounts.json
SESSION_DAYS=30
MAX_USERS=500
ARCHIVE_DIR=/archive
ARCHIVE_SEGMENT_SECONDS=60
ARCHIVE_RETENTION_DAYS=7
# Create a scoped Dropbox app and register DROPBOX_REDIRECT_URI before enabling OAuth.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://control.nelloonrender.duckdns.org/api/cloud/dropbox/callback
DASHBOARD_URL=https://yi-web-viewer.onrender.com
