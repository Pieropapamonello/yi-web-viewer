ONVIF_HOST=192.168.1.50
TZ=Europe/Rome
ONVIF_PORT=8080
ONVIF_USERNAME=admin
ONVIF_PASSWORD=replace-locally
API_TOKEN=replace-with-at-least-24-random-characters
ALLOWED_ORIGIN=https://yi-web-viewer.onrender.com
PTZ_SPEED=0.45
PTZ_DURATION_MS=350
ONVIF_TIME_OFFSET_MS=0
IPC365_PTZ_PORT=23456
IPC365_PTZ_STEP=12
# Four raw bytes (8 hexadecimal characters) captured from the IPC365 session.
# PCAPdroid: command 0x4f77, offsets 20 and 24. These values are not passwords.
IPC365_SOURCE_ID=af93c63b
IPC365_DEVICE_ID=09f74b01
# Optional verified device actions. Each IPC command needs the captured request
# and a stable byte sequence from its response, both encoded as base64.
# IPC365_DEVICE_COMMANDS_JSON={"light:on":{"frame":"BASE64_REQUEST","expect":"BASE64_ACK"},"light:off":{"frame":"BASE64_REQUEST","expect":"BASE64_ACK"}}
IPC365_DEVICE_COMMANDS_JSON=
# Enable only after a model-specific talk session has been captured and verified.
IPC365_TALK_ENABLED=false
FREDI_PTZ_HOST=192.168.1.78
FREDI_PTZ_PORT=23
FREDI_PTZ_COMMAND=/var/tmp/sd/ptzctl
FREDI_PTZ_FAST_PORT=23459
# Fixed allow-listed commands supplied by an installed on-camera helper.
# FREDI_DEVICE_COMMANDS_JSON={"light:on":"/var/tmp/sd/devctl light on","light:off":"/var/tmp/sd/devctl light off"}
FREDI_DEVICE_COMMANDS_JSON=
FREDI_TALK_DEVICE=1
DASHBOARD_PASSWORD_ITERATIONS=310000
AUTH_SECRET=generated-locally
VAULT_KEY=generated-locally
ACCOUNTS_FILE=/data/accounts.json
SESSION_DAYS=30
MAX_USERS=500
ARCHIVE_DIR=/archive
MANUAL_CLIP_MAX_BYTES=250000000
ARCHIVE_SEGMENT_SECONDS=60
ARCHIVE_RETENTION_DAYS=7
# Create a scoped Dropbox app and register DROPBOX_REDIRECT_URI before enabling OAuth.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://control.nelloonrender.duckdns.org/api/cloud/dropbox/callback
DASHBOARD_URL=https://yi-web-viewer.onrender.com
# Smart Vision: use a server-side key. Never place it in web/config.js.
# With the FREDI Cloudflare Worker AI_API_KEY can stay blank: the gateway reuses API_TOKEN,
# while the Worker stores only its SHA-256 hash. Groq defaults are shown as fallback.
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.6-27b
AI_TIMEOUT_MS=45000
